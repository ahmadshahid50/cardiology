# Enquiry form delivery.
# Without these, the form returns a clear "unavailable" message and the UI
# falls back to the practice phone numbers — nothing is silently discarded.

# API key from https://resend.com
RESEND_API_KEY=

# Verified sender for the practice's domain.
ENQUIRY_FROM="Advanced Cardiology Website <website@advancedcardiology.com.au>"

# Optional. When unset, each enquiry goes to the inbox for the location the
# patient selected (info@advancedcardiology.com.au or reception@theshhc.com.au).
ENQUIRY_TO=
